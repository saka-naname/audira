{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "dialog:default",
    {
      "identifier": "store:default",
      "allow": [{ "path": "config.json" }]
    }
  ]
}